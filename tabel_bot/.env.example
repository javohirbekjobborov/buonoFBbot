# Nusxa oling: cp .env.example .env — va qiymatlarni to'ldiring.
# .env faylini hech qachon GitHub ga yuklamang!

# @BotFather dan olingan YANGI bot tokeni (majburiy)
BOT_TOKEN=

# Rahbarlarning Telegram ID raqamlari, vergul bilan (ixtiyoriy).
# Buono Tabel guruhining egasi va adminlari avtomatik rahbar hisoblanadi.
# O'z ID ingizni bilish uchun botga /id yozing.
ADMIN_IDS=

# Buono Tabel guruhi ID si (ixtiyoriy). Bo'sh qoldirsangiz, guruhda /ulash yozing.
GROUP_ID=

# Hisobotlar qo'shimcha yuboriladigan chatlar (ixtiyoriy), masalan rahbarning shaxsiy chati.
# Rahbar avval botga /start yozgan bo'lishi kerak.
REPORT_CHAT_IDS=

# Hisobotlar guruhga ham yuborilsinmi: 1 — ha, 0 — yo'q (faqat REPORT_CHAT_IDS ga)
REPORTS_TO_GROUP=1

# Ma'lumotlar bazasi fayli. Serverda doimiy saqlanadigan joyda bo'lsin, masalan: /data/tabel.db
DB_PATH=
